meta {
  name: POST registro (201)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "username": "karla",
    "password": "Password123"
  }
}

tests {
  test("responde 201", function () { expect(res.status).to.equal(201); });
  test("no devuelve la contraseña", function () { expect(res.body.password).to.equal(undefined); });
}
