meta {
  name: POST tarea (201)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/tareas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "titulo": "Primera tarea",
    "proyectoId": {{proyectoId}}
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("tareaId", res.body.id);
}

tests {
  test("responde 201", function () { expect(res.status).to.equal(201); });
  test("estado inicial PENDIENTE", function () { expect(res.body.estado).to.equal("PENDIENTE"); });
}
