meta {
  name: PUT tarea inexistente (404)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/tareas/999999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "estado": "COMPLETADA"
  }
}

tests {
  test("responde 404", function () { expect(res.status).to.equal(404); });
}
